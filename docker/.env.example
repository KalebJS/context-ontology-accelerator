# ── General ────────────────────────────────────────────────────────────
# Deployment prefix mirrored into resource naming (tables, buckets).
SCL_PREFIX=coa
SCL_ENV=local
LOG_LEVEL=INFO

# ── Ports (host side) ──────────────────────────────────────────────────
WEB_PORT=3000
GATEWAY_PORT=9090
CM_PORT=8081
MCP_PORT=8002
OE_PORT=8001
DL_PORT=8083
VKG_PORT=8180
LOCALSTACK_PORT=8888
KEYCLOAK_PORT=8280
OPENSEARCH_PORT=9200
FUSEKI_PORT=3030
POSTGRES_PORT=5432

# ── Ollama (host) ──────────────────────────────────────────────────────
# From inside containers, the host's Ollama is reachable via host.docker.internal.
# If Ollama runs in Docker on the same host, OLLAMA_BASE_URL=http://ollama:11434
# and add an "ollama" service (image: ollama/ollama) plus network config.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Chat model tag for ALL LLM paths (chat, induction, enrichment, synthesis).
OLLAMA_CHAT_MODEL=gemma4:latest
# Embedding model tag. mxbai-embed-large is 1024-dim = DEFAULT_EMBED_DIMENSIONS.
OLLAMA_EMBED_MODEL=mxbai-embed-large:latest
OLLAMA_TIMEOUT_S=120
# Bounded retry for transient LLM chat failures (HTTP 429/5xx, connection/timeout
# errors) on the kg-build extraction path. OLLAMA_MAX_RETRIES is TOTAL attempts
# including the first; OLLAMA_RETRY_BACKOFF_S is the exponential base delay;
# OLLAMA_RETRY_CAP_S caps any single retry delay. Defaults never trigger on a
# healthy endpoint; a single transient 503 otherwise aborts a hours-long run.
#OLLAMA_MAX_RETRIES=5
#OLLAMA_RETRY_BACKOFF_S=2
#OLLAMA_RETRY_CAP_S=30

# Set to 0 to skip CloudWatch PutMetricData emission (ontology-engine induction
# cost/heartbeat metrics). LocalStack has no valid CloudWatch creds, so every
# emission logs InvalidClientTokenId noise — 0 silences it. On AWS leave unset.

# ── Keycloak (local Cognito replacement) ───────────────────────────────
KC_ADMIN=admin
KC_ADMIN_PASSWORD=Passw0rd!
# Issuer as seen from containers (JWT validation) — host port mapping.
KC_ISSUER_INTERNAL=http://keycloak:8080/realms/coa
# Issuer as seen from the browser / Playwright (host side).
KC_ISSUER_PUBLIC=http://localhost:8280/realms/coa
KC_REALM=coa
KC_WEB_CLIENT_ID=coa-web
KC_MCP_CLIENT_ID=coa-mcp
# Initial user (also used by Playwright E2E)
E2E_USERNAME=admin@coa.local
E2E_PASSWORD=Passw0rd!

# ── LocalStack ─────────────────────────────────────────────────────────
LOCALSTACK_SERVICES=dynamodb,s3,ssm,secretsmanager,sqs,events,sts,lambda
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# The AWS_ENDPOINT_URL_* style is not supported by all boto3 paths here, so
# every service container gets LOCALSTACK_ENDPOINT and resolves endpoints via
# SCL local-mode env vars.
LOCALSTACK_ENDPOINT=http://localstack:4566

# ── Demo source database (the "customer" Postgres) ─────────────────────
DEMO_DB=coa_demo
DEMO_DB_USER=coa
DEMO_DB_PASSWORD=changeme

# ── VKG ────────────────────────────────────────────────────────────────
VKG_ENDPOINT=http://vkg-router:8180

# ── Fuseki / OpenSearch ────────────────────────────────────────────────
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=coa
OPENSEARCH_URL=http://opensearch:9200

# ── Local-only overrides (see docker/README.md) ────────────────────────
# Fuseki serves named-graph GSP without a trailing slash (Neptune default is /sparql/gsp/).
NDB_GSP_PATH=/sparql/gsp
# Vanilla OpenSearch defaults to NMSLIB, which rejects filtered k-NN; faiss needs space_type=l2.
OSS_KNN_ENGINE=faiss
# Internal context-manager call timeout; AWS default is 29s (API Gateway cap).
DATA_LAYER_CM_TIMEOUT_S=120

# ── Web runtime config ─────────────────────────────────────────────────
# Rendered into public/runtime-config.json by the web-app container entrypoint.
WEB_API_ENDPOINT=http://localhost:9090
