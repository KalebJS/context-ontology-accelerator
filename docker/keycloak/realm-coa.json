{
  "realm": "coa",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 43200,
  "roles": {
    "realm": [
      { "name": "platform-admin", "description": "Platform administrator" },
      { "name": "data-analyst", "description": "Namespace analyst" }
    ]
  },
  "groups": [
    {
      "name": "platform-admins",
      "path": "/platform-admins"
    },
    {
      "name": "analysts",
      "path": "/analysts"
    }
  ],
  "clients": [
    {
      "clientId": "coa-web",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173"],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "defaultClientScopes": ["openid", "email", "profile", "basic"],
      "protocolMappers": [
        {
          "name": "groups mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.group.path": false,
            "id.token.claim": true,
            "access.token.claim": true,
            "userinfo.token.claim": true,
            "claim.name": "groups"
          }
        }
      ]
    },
    {
      "clientId": "coa-mcp",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:9876/oauth/callback"],
      "webOrigins": ["http://localhost:9876"],
      "defaultClientScopes": ["openid", "email", "profile", "basic"],
      "protocolMappers": [
        {
          "name": "groups mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.group.path": false,
            "id.token.claim": true,
            "access.token.claim": true,
            "userinfo.token.claim": true,
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@coa.local",
      "email": "admin@coa.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "COA",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "Passw0rd!",
          "temporary": false
        }
      ],
      "groups": ["/platform-admins"]
    },
    {
      "username": "analyst@coa.local",
      "email": "analyst@coa.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "COA",
      "lastName": "Analyst",
      "credentials": [
        {
          "type": "password",
          "value": "Passw0rd!",
          "temporary": false
        }
      ],
      "groups": ["/analysts"]
    }
  ]
}
