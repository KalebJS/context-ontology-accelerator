{
  "name": "local-gateway",
  "root": "docker/gateway",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "docker build -f docker/gateway/Dockerfile -t coa-local-gateway:latest ."
