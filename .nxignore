# external-docs (nx project "coa-docs") is the standalone Vite docs site.
# It is intentionally NOT part of the root pnpm workspace (it has its own
# pnpm-lock.yaml) and is built/deployed independently by the `pages` CI job
# (ci/pages.yml). Without this ignore, nx's package-json plugin would still
# discover it as a project, so `pnpm nx run-many -t build` (cdk-synth-main,
# deploy-dev, etc.) would try to build it without its deps installed and fail
# with "tsc: not found". Keep it out of the nx project graph.
external-docs

# connectors/ is the same case as external-docs above: a workspace of its own with
# its own pnpm-lock.yaml, deliberately outside the root pnpm workspace so the samples
# still build once a customer copies them out. Its three package.json files
# (coa-connectors, coa-connector-cdk, coa-example-connector-cdk) are otherwise
# discovered by nx's package-json plugin, and `nx affected`/`run-many` then runs their
# build/test/synth targets in a checkout where they have no node_modules — "cdk: not
# found", "node_modules missing, did you mean to install?". The connectors have their
# own CI jobs (unit-test-{main,mr}-connectors), which install inside connectors/ first.
connectors

# Agent git worktrees live INSIDE the repo at .claude/worktrees/<id>. Each is a
# full checkout, so nx's package-json plugin discovers duplicate projects
# (infra, web-app, ts-shared, root) and fails the graph with
# MultipleProjectsWithSameNameError. Keep transient worktrees out of the graph.
.claude/worktrees
